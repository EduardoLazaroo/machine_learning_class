# ------------------------------------------------------------------------------
# Arquivos Temporários, Compilados e Cache do Python / Jupyter
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook & Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Ambientes Virtuais
venv/
.venv/
env/
ENV/

# Configurações de IDEs e Editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs e Dados Temporários
*.log
tmp/
*.tmp

